{
  "name": "ledgerjs-loader",
  "version": "1.0.0",
  "description": "JavaScript port of ledgerblue for loading applications onto Ledger hardware wallets",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./hexParser": "./src/hexParser.js",
    "./hexLoader": "./src/hexLoader.js",
    "./ecWrapper": "./src/ecWrapper.js",
    "./deployed": "./src/deployed.js",
    "./transport": "./src/transport.js",
    "./loadApp": "./src/loadApp.js",
    "./ledgerWrapper": "./src/ledgerWrapper.js",
    "./commException": "./src/commException.js"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --format=esm --outfile=dist/ledgerjs.bundle.js",
    "test": "node --experimental-vm-modules test/run_all_tests.js",
    "test:hexParser": "node test/test_hexParser.js",
    "test:ledgerWrapper": "node test/test_ledgerWrapper.js",
    "test:ecWrapper": "node test/test_ecWrapper.js",
    "test:deployed": "node test/test_deployed.js",
    "test:transport": "node test/test_transport.js",
    "test:hexLoader": "node test/test_hexLoader.js",
    "test:loadApp": "node test/test_loadApp.js"
  },
  "keywords": [
    "ledger",
    "hardware-wallet",
    "cryptocurrency",
    "bitcoin",
    "ethereum",
    "sideload",
    "ledgerblue"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/hashes": "^1.3.0",
    "@noble/secp256k1": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "files": [
    "src/",
    "index.js",
    "README.md"
  ]
}
